<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema id="org.gnome.shell.extensions.huawei-wmi" path="/org/gnome/shell/extensions/huawei-wmi/">
		<key name="hwmi-config" type="as">
			<default><![CDATA[['XF86ControlPanel']]]></default>
			<summary></summary>
		</key>

		<key name="hwmi-power-unlock" type="as">
			<default><![CDATA[['XF86Launch1', 'XF86Battery']]]></default>
			<summary></summary>
		</key>

		<key name="hwmi-camera-detached" type="as">
			<default><![CDATA[['XF86Launch2']]]></default>
			<summary></summary>
		</key>

		<key name="hwmi-camera-attached" type="as">
			<default><![CDATA[['XF86Launch3']]]></default>
			<summary></summary>
		</key>

		<key name="hwmi-camera-ejected" type="as">
			<default><![CDATA[['XF86CameraAccessEnable']]]></default>
			<summary></summary>
		</key>

		<key name="hwmi-camera-inserted" type="as">
			<default><![CDATA[['XF86CameraAccessDisable']]]></default>
			<summary></summary>
		</key>

		<key name="show-fn-lock-tile" type="b">
			<default>true</default>
			<summary>Show the Fn-Lock Quick Settings tile</summary>
		</key>

		<key name="show-battery-mode-tile" type="b">
			<default>true</default>
			<summary>Show the battery mode Quick Settings tile</summary>
		</key>

	</schema>
</schemalist>
